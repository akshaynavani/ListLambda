# Used by `make loadtest` / loadtest/run.sh and local tooling. Copy to .env and fill in.
AWS_PROFILE=default
AWS_REGION=us-east-1
STAGE=dev

# Base URL of the deployed HTTP API (ApiUrl stack output)
API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# Load test knobs
USERS=500
SPAWN_RATE=50
DURATION=5m
P99_TARGET_MS=100
MAX_FAILURE_RATIO=0.01
